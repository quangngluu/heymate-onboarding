# Worldform runs with deterministic zero-cost adapters unless this is `live`.
VITE_WORLDFORM_PROVIDER=mock

# Required only for VITE_WORLDFORM_PROVIDER=live.
FAL_KEY=
MESHY_API_KEY=

# Existing companion-universe providers.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
SPOON_API_KEY=
SPOON_VOICE_ID=

# English-only Rin EVI demo. Hume credentials stay server-side; only the
# non-secret config id is compiled into the browser. vite.config.ts mirrors
# /api/hume-token during `npm run dev`.
HUME_API_KEY=
HUME_SECRET_KEY=
VITE_HUME_CONFIG_ID=
