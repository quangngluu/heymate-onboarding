{
  "name": "heymate-onboarding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:quest-smoke": "node scripts/quest-phase2-smoke.mjs",
    "build": "tsc --noEmit && vite build",
    "verify:canon": "tsx scripts/verify-canon.ts && tsx scripts/export-character-data.ts --route=hub --check && tsx scripts/export-character-data.ts --route=sao --check",
    "verify": "npm run build && npm run verify:canon",
    "preview": "vite preview",
    "push:github": "git -C .. subtree push --prefix=heymate-onboarding heymate-github main"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@types/node": "^22.20.0",
    "@types/three": "^0.169.0",
    "gltfpack": "^1.2.0",
    "puppeteer-core": "^25.3.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^3.2.4"
  }
}
